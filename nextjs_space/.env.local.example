SUBSCRIBESTAR_CLIENT_ID=your_client_id
SUBSCRIBESTAR_CLIENT_SECRET=your_client_secret
SUBSCRIBESTAR_REDIRECT_URI=http://localhost:3000/api/auth/subscribestar/callback
SUBSCRIBESTAR_WEBHOOK_SECRET=your_webhook_secret

SUBSCRIBESTAR_TIER_BASIC_ID=
SUBSCRIBESTAR_TIER_PRO_ID=
SUBSCRIBESTAR_TIER_ELITE_ID=
