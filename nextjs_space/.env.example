# Primary chat model (NovelAI Llama 3 Erato). Override either name; NEXT_PUBLIC_ is visible to the UI.
CHAT_MODEL=llama-3-erato-v1
NEXT_PUBLIC_DEFAULT_MODEL=llama-3-erato-v1
CHAT_PROVIDER=NOVELAI
NEXT_PUBLIC_DEFAULT_PROVIDER=NOVELAI

# Paid NovelAI text generation (required for production chat)
NOVELAI_API_KEY=

# OpenRouter — used for upload-time + Rule-A live VLM turns
OPENROUTER_API_KEY=
OPENROUTER_VLM_MODEL=qwen/qwen-2.5-vl-72b-instruct
OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# Optional Groq/custom fallback — never the app-wide default when NovelAI is configured
CUSTOM_MODEL_NAME=openai/gpt-oss-20b

# PayPal subscriptions (billing)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# SubscribeStar webhook sync (optional second billing provider)
# HMAC secret for X-SubscribeStar-Signature (sha256 hex of raw body)
SUBSCRIBESTAR_WEBHOOK_SECRET=
# Optional comma-separated external plan ids mapped to Nexus tiers
SUBSCRIBESTAR_PLUS_TIER_IDS=
SUBSCRIBESTAR_PREMIUM_TIER_IDS=
SUBSCRIBESTAR_ULTIMATE_TIER_IDS=
