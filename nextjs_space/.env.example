# Primary chat model (NovelAI Llama 3 Erato). Override either name; NEXT_PUBLIC_ is visible to the UI.
CHAT_MODEL=llama-3-erato-v1
NEXT_PUBLIC_DEFAULT_MODEL=llama-3-erato-v1
CHAT_PROVIDER=NOVELAI
NEXT_PUBLIC_DEFAULT_PROVIDER=NOVELAI

# Paid NovelAI text generation (required for production chat)
NOVELAI_API_KEY=

# OpenRouter — used for upload-time + Rule-A live VLM turns
OPENROUTER_API_KEY=
OPENROUTER_VLM_MODEL=qwen/qwen-2.5-vl-72b-instruct
OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# Optional Groq/custom fallback — never the app-wide default when NovelAI is configured
CUSTOM_MODEL_NAME=openai/gpt-oss-20b

# --- SubscribeStar.adult billing (PayPal removed) ---
# Public profile / checkout landing (required for outbound tier buttons)
NEXT_PUBLIC_SUBSCRIBESTAR_PROFILE_URL=https://www.subscribestar.adult/your-profile
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# OAuth2 application (Profile Settings → OAuth Apps on SubscribeStar)
SUBSCRIBESTAR_CLIENT_ID=
SUBSCRIBESTAR_CLIENT_SECRET=
# Defaults to ${NEXT_PUBLIC_SITE_URL}/api/auth/subscribestar/callback when empty
SUBSCRIBESTAR_REDIRECT_URI=

# Webhooks (Profile Settings → Webhooks). HMAC-MD5 of raw body.
SUBSCRIBESTAR_WEBHOOK_SECRET=

# Map SubscribeStar tier IDs → Nexus Plus / Premium / Ultimate
# Costs in cents: 999=$9.99 (Plus), 2999=$29.99 (Premium), 5000=$50.00 (Ultimate)
SUBSCRIBESTAR_TIER_BASIC_ID=
SUBSCRIBESTAR_TIER_PRO_ID=
SUBSCRIBESTAR_TIER_ELITE_ID=

# fal.ai scene / portrait generation
FAL_KEY=
OPENROUTER_SCENE_MODEL=

# --- Watchdog / SMS alerts (optional; see docs/NEXUS_WATCHDOG.md) ---
# Production origin for Discover + health probes
NEXUS_HEALTHCHECK_BASE_URL=
# Optional public profile username to probe (/u/{user})
NEXUS_HEALTHCHECK_PROFILE_USER=
# Twilio SMS (never commit real values). Logs mask the destination number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_PHONE_NUMBER=
# Or POST JSON { text, fingerprint, source, sentAt } instead of Twilio:
ALERT_SMS_WEBHOOK_URL=
ALERT_SMS_COOLDOWN_MINUTES=60
ALERT_SMS_COOLDOWN_FILE=
