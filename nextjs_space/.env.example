# Primary chat model (NovelAI Llama 3 Erato). Override either name; NEXT_PUBLIC_ is visible to the UI.
CHAT_MODEL=llama-3-erato-v1
NEXT_PUBLIC_DEFAULT_MODEL=llama-3-erato-v1
CHAT_PROVIDER=NOVELAI
NEXT_PUBLIC_DEFAULT_PROVIDER=NOVELAI

# Paid NovelAI text generation (required for production chat)
NOVELAI_API_KEY=

# Optional fallbacks — never used as the app-wide default when NovelAI is configured
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
CUSTOM_MODEL_NAME=openai/gpt-oss-20b
