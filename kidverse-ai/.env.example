# Optional — when set, play screen calls the Supabase realm-turn Edge Function.
# Without these, KidVerse AI uses the local mock adventure engine for Expo preview.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge Function secrets (set via `supabase secrets set`, not in the app)
# OPENAI_API_KEY=
# KIDVERSE_MODEL=gpt-4o-mini
